# ===========================================
# PhishGuard Environment Configuration
# ===========================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ===========================================

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-this-to-a-random-secret-key

# Database
DATABASE_URL=postgresql+asyncpg://phishguard:phishguard@localhost:5432/phishguard
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
RATE_LIMIT_PER_MINUTE=10
MAX_REDIRECTS=3
REQUEST_TIMEOUT_SECONDS=15
MAX_RESPONSE_SIZE_BYTES=5242880

# Screenshot Service
SCREENSHOT_VIEWPORT_WIDTH=1280
SCREENSHOT_VIEWPORT_HEIGHT=720
SCREENSHOT_TIMEOUT_MS=15000

# OCR
OCR_LANGUAGES=en
OCR_GPU=false

# Visual Model
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
FAISS_INDEX_PATH=data/brand_references/brand_index.faiss

# MLflow
MLFLOW_TRACKING_URI=file:///ml/experiments/mlruns
MLFLOW_EXPERIMENT_NAME=phishguard

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
